---
import '../styles/global.css';
import { publications } from '../data/publications';
import { links, projects, people, career, courses, leadership, software, training } from '../data/group';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = 'Mikhasenko Group · Hadron Physics at RUB';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The research group of Prof. Mikhail Mikhasenko at Ruhr University Bochum. Hadron spectroscopy, amplitude analysis, detector development and teaching." />
    <meta name="theme-color" content="#003560" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Exploring the strong interaction, from exotic hadrons to the detectors that reveal them." />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
    <link rel="icon" type="image/png" href={`${base}/images/group-logo.png`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <div class="institution"><div class="wrap institution-inner"><span>RUHR UNIVERSITY BOCHUM</span><span>Experimental Physics I</span></div></div>
      <div class="wrap nav-row">
        <a class="brand" href="#" aria-label="Mikhasenko Group home"><img src={`${base}/images/group-logo.png`} width="48" height="48" alt="" /><span>MIKHASENKO<span class="brand-sub">RESEARCH GROUP</span></span></a>
        <nav aria-label="Main navigation"><a href="#research">Research</a><a href="#people">People</a><a href="#teaching">Teaching</a><a href="#publications">Publications</a><a class="nav-contact" href="#contact">Get in touch <span aria-hidden="true">↗</span></a></nav>
      </div>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="eyebrow"><span class="dot"></span> HADRON PHYSICS · BOCHUM</p><h1 id="hero-title">Small particles.<br />Fundamental<br /><span class="highlight">questions.</span></h1><p class="lead">Exploring how quarks and gluons form matter, and what exotic hadrons reveal about the strong interaction.</p><div class="actions"><a class="button" href="#research">Explore our research <span aria-hidden="true">↗</span></a><a class="text-link" href="#people">Meet the group <span aria-hidden="true">→</span></a></div></div>
        <figure class="particle-figure">
          <a class="density-link" href="https://mmikhasenko.github.io/GIModel.jl/dev/" aria-label="Explore the Υ(3S) state in GIModel.jl">
            <svg viewBox="2200 0 1100 1010" role="img" aria-labelledby="density-title density-description">
              <title id="density-title">Υ(3S) meson density from GIModel.jl</title>
              <desc id="density-description">The 3³S₁ bottomonium state, shown as a purple density cloud with radial shell structure and a 0.5 femtometre scale bar. Model visualization from the supplied vector-meson density figure.</desc>
              <image href={`${base}/images/vector-meson-densities.png`} width="3300" height="1520" />
            </svg>
          </a>
          <figcaption><span>Υ(3S) · Meson density</span><a href="https://mmikhasenko.github.io/GIModel.jl/dev/">Computed with GIModel.jl ↗</a></figcaption>
        </figure>
      </section>
      <div class="collaboration-band"><div class="wrap collaboration-inner"><span class="eyebrow">CONNECTED THROUGH SCIENCE</span><a href="https://lhcb-outreach.web.cern.ch/">LHCb <span>↗</span></a><a href="https://wwwcompass.cern.ch/">COMPASS <span>↗</span></a><a href="https://www.jpac-physics.org/">JPAC <span>↗</span></a><a href="https://pdg.lbl.gov/">Particle Data Group <span>↗</span></a><a href="https://democratizing-models.github.io/consortium/index.html">DEMOS <span>↗</span></a><a href="https://www.cost.eu/actions/CA24159/">SHARP <small>COST Action CA24159</small><span>↗</span></a><span class="network-name">HADRON2030</span></div></div>
      <section id="research" class="section wrap">
        <div class="section-heading"><div><p class="eyebrow">01 / RESEARCH</p><h2>Understanding matter.<br />Connecting the pieces.</h2></div><p>We bring experiment, theory and computation together to study the rich spectrum of hadrons.</p></div>
        <div class="research-grid">{projects.map(project => <article class="research-card"><div class="card-top"><span>{project.number}</span><span aria-hidden="true">↗</span></div><p class="eyebrow">{project.tag}</p><h3>{project.title}</h3><p>{project.text}</p><div class="card-detail">{project.detail}</div></article>)}</div>
        <div class="software-section"><p class="eyebrow">OPEN & REUSABLE RESEARCH</p><h3>Physics you can build on.</h3><p>Our Julia tools turn reaction theory and quark models into inspectable, reusable scientific software.</p><div class="software-grid">{software.map(([name, description, url]) => <article><h4>{url ? <a href={url}>{name} ↗</a> : name}</h4><p>{description}</p></article>)}</div></div>
        <div class="section-note"><span>From CERN experiments to phenomenological models.</span><a class="text-link" href={links.group}>Research at EP1 ↗</a></div>
      </section>
      <section id="people" class="people-section section"><div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">02 / PEOPLE</p><h2>A shared curiosity.</h2></div><p>Our group at Ruhr University Bochum brings together researchers and students working across hadron physics.</p></div>
        <div class="profile"><div class="profile-intro"><span class="eyebrow">GROUP LEADER</span><h3>Prof. Dr.<br />Mikhail Mikhasenko</h3><p>Professor at the Institute of Experimental Physics I since November 2023.</p><div class="profile-links"><a href={links.faculty}>Faculty profile ↗</a><a href="https://orcid.org/0000-0002-6969-2063">ORCID ↗</a><a href="https://inspirehep.net/authors/1753871">INSPIRE ↗</a></div><p class="small">Hadron spectroscopy · Reaction modeling and amplitude analysis · Detector development and photosensor readout · Machine learning in HEP</p></div><div class="timeline" aria-label="Short curriculum vitae">{career.map(([date, role, place]) => <div class="career"><span>{date}</span><div><h4>{role}</h4><p>{place}</p></div></div>)}</div></div>
        <div class="leadership-grid">{leadership.map(([role, detail]) => <article><h3>{role}</h3><p>{detail}</p></article>)}</div>
        <div class="team-grid">{people.map(([name, role]) => <article class="person"><span class="person-mark" aria-hidden="true">{name.split(' ').map(part => part[0]).slice(0, 2).join('')}</span><div><h3>{name}</h3><p>{role}</p></div></article>)}</div>
        <div class="section-note"><span>Roster checked October 2026.</span><a class="text-link" href={links.members}>EP1 members directory ↗</a></div>
      </div></section>
      <section id="teaching" class="section wrap teaching-layout"><div class="teaching-intro"><p class="eyebrow">03 / TEACHING</p><h2>Learn the physics.<br />Ask the next question.</h2><p>From nuclear and particle physics to advanced data analysis: selected lectures, exercises and seminars taught by Mikhail Mikhasenko.</p><a class="text-link" href={links.teaching}>EP1 course listings ↗</a><div class="student-note"><span class="eyebrow">BACHELOR’S & MASTER’S THESES</span><h3>Start with a question.</h3><p>Interested in data analysis, phenomenology or detector development? Get in touch to discuss a project.</p><a class="text-link" href={`${links.email}?subject=Thesis%20project%20enquiry`}>Discuss a thesis project ↗</a></div></div><div class="course-list"><p class="eyebrow course-label">SELECTED TEACHING · 2024–2026</p>{courses.map(({term, name, detail, references}) => <article class="course"><span class="term">{term}</span><h3>{name}</h3><p>{detail}</p>{references && <ul class="course-references" aria-label={`Resources for ${name}`}>{references.map(({label, url}) => <li><a href={url}>{label} ↗</a></li>)}</ul>}</article>)}<p class="small">Dated teaching history. See EP1 for course availability and registration details.</p></div></section>
      <section class="wrap training-section" aria-labelledby="training-title"><p class="eyebrow">ADVANCED TRAINING & OPEN EDUCATION</p><h2 id="training-title">Sharing the tools of discovery.</h2><div class="training-grid">{training.map(([title, description, url]) => <article><h3>{title}</h3><p>{description}</p>{url && <a class="text-link" href={url}>Explore the resource ↗</a>}</article>)}</div></section>
      <section id="publications" class="section publications-section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">04 / SELECTED PUBLICATIONS</p><h2>Ideas, tested against data.</h2></div><a class="text-link" href="https://inspirehep.net/authors/1753871">Explore the publication record ↗</a></div><nav class="publication-index" aria-label="Publication categories">{publications.map(group => <a href={`#papers-${group.id}`}>{group.title}</a>)}</nav>
        <div class="publication-groups">{publications.map(group => <section class="publication-group" id={`papers-${group.id}`} aria-labelledby={`heading-${group.id}`}><h3 id={`heading-${group.id}`}>{group.title}</h3><div class="publication-list">{group.papers.map(paper => <article class="paper-entry"><div class="paper-main"><h4><a href={`https://inspirehep.net/literature/${paper.inspire}`}>{paper.title}</a></h4><p>{paper.citation}</p><a class="paper-inspire" href={`https://inspirehep.net/literature/${paper.inspire}`}>{paper.label === 'Discovery' ? 'Discovery · INSPIRE' : paper.label || 'INSPIRE'} ↗</a>{paper.extra && <a class="paper-extra" href={paper.extra.url}>{paper.extra.label} ↗</a>}</div>{paper.companion && <div class="paper-companion"><h4><a href={`https://inspirehep.net/literature/${paper.companion.inspire}`}>{paper.companion.title}</a></h4><p>{paper.companion.citation}</p><a class="paper-inspire" href={`https://inspirehep.net/literature/${paper.companion.inspire}`}>Follow-up study · INSPIRE ↗</a></div>}</article>)}</div></section>)}</div></div></section>
      <section id="contact" class="section wrap"><div class="contact-panel"><div><p class="eyebrow">05 / JOIN THE CONVERSATION</p><h2>Good physics starts<br />with a connection.</h2><p>For research collaborations and bachelor’s or master’s projects, we’d love to hear from you.</p><a class="button light" href={links.email}>mikhail.mikhasenko@rub.de <span aria-hidden="true">↗</span></a></div><address><strong>Find us in Bochum</strong><br />Ruhr University Bochum<br />Experimental Physics I<br />Universitätsstraße 150<br />44801 Bochum, Germany<br /><br />NB building · First floor<br /><a href="tel:+492343212275">+49 234 32 12275</a><br /><a href="https://maps.app.goo.gl/uyEPZsB8Ep3vmPsG9">Campus directions ↗</a></address></div><div class="welcome"><p>Different perspectives make better science. We welcome students from diverse backgrounds, including those with non-traditional paths into physics.</p><a class="text-link" href="https://uni.ruhr-uni-bochum.de/en/diversity">Diversity at RUB ↗</a></div></section>
    </main>
    <footer class="wrap"><div><strong>MIKHASENKO GROUP</strong><p>Hadron physics · Ruhr University Bochum</p></div><div class="footer-links"><a href={links.faculty}>Faculty</a><a href="https://github.com/mmikhasenko/agmikhasenko">GitHub</a><a href="https://indico.cern.ch/category/18592/">Seminars</a><a href="https://www.physik.ruhr-uni-bochum.de/en/impressum/">Faculty legal notice</a><a href="https://www.physik.ruhr-uni-bochum.de/en/datenschutz/">Faculty privacy policy</a><a href="#">Back to top ↑</a></div></footer>
  </body>
</html>
